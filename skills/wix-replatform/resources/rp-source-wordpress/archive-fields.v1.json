{
  "schemaVersion": 1,
  "sourcePlatforms": [
    "wordpress",
    "woocommerce"
  ],
  "about": "WordPress/WooCommerce additions to rp-target-wix/domains/cms/source-archive-fields.v1.json. Same rule shape and precedence (personal-drop, keep, noise; unmatched = keep). Only plumbing, SEO output handled by the SEO writers, page-builder/theme data and tracking flags belong here; never a business value.",
  "personalDrop": [],
  "keep": [],
  "noise": [
    {
      "id": "wp-seo-output",
      "reasonCode": "archive-noise",
      "on": "any",
      "regex": "^yoast_head(_json)?$|^_yoast_wpseo_(content_score|linkdex|estimated-reading-time-minutes)$|^rank_math_(seo_score|internal_links_processed)$"
    },
    {
      "id": "wp-post-plumbing",
      "reasonCode": "archive-noise",
      "on": "leaf",
      "regex": "^(guid|class_list|template|ping_status|comment_status|to_ping|pinged|permalink_template|generated_slug|post_mime_type|comment_count|post_content_filtered|format|sticky)$"
    },
    {
      "id": "wp-page-builder-and-theme",
      "reasonCode": "archive-noise",
      "on": "any",
      "regex": "^_?elementor|^thegem_|^_wpb_|^_wp_page_template$|^_customize_sidebars$|^_nickx_|^_edit_(lock|last)$"
    },
    {
      "id": "wp-old-values",
      "reasonCode": "archive-noise",
      "on": "any",
      "regex": "^_wp_old_(slug|date)$"
    },
    {
      "id": "woo-meta-display-copy",
      "reasonCode": "archive-noise",
      "on": "leaf",
      "regex": "^display_value$",
      "under": "list"
    },
    {
      "id": "woo-feed-sync",
      "reasonCode": "archive-noise",
      "on": "any",
      "regex": "^_wc_gla_|_sync_status$|^inforu_sync_flag$"
    },
    {
      "id": "woo-tracking-plugins",
      "reasonCode": "archive-noise",
      "on": "any",
      "regex": "^_?pys_|^_wm_(notified|pixels_fired|purchase_evt_sent|sale_sent)$|^_googlesitekit_|^_gobit_verify$|^order_validated$"
    },
    {
      "id": "woo-import-and-session",
      "reasonCode": "archive-noise",
      "on": "any",
      "regex": "^_?wt_import_key$|^_download_permissions$|^default_password_nag$|^wc_last_active$|^elementor_admin_notices$|^_custom_meta_key$|^pewc_(has_uploads|product_extras_created)$"
    },
    {
      "id": "payplus-plumbing",
      "reasonCode": "archive-noise",
      "on": "any",
      "regex": "^payplus_(print_log|function_end|check_invoice_send|page_request_uid|page_request_uid_history|time_link|payment_page_link|generate_products_link|error_invoice)$"
    }
  ]
}
