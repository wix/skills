    {
      "id": "media-external-id",
      "sourcePaths": [
        "id"
      ],
      "disposition": "native",
      "reason": "The WordPress attachment id is recorded as the file external id (origin wordpress) so a reply lost mid-import can be reconciled and the crosswalk keyed. Every media library file is imported (import everything); posts and products resolve their images to these files by source URL.",
      "evidence": [
        "resources/rp-target-wix/domains/media/entities/media-file.json (preferredWrite importMedia; mappingGuidance: import referenced media by default)",
        "resources/rp-target-wix/lib/blog-post-media.js (post media import: cover and inline images)",
        "resources/rp-mapper/SKILL.md \"Default media scope\""
      ],
      "transform": {
        "kind": "expression",
        "expression": "externalInfo = { origin: \"wordpress\", externalId: String(id) } for a positive integer id."
      },
      "valuePolicy": {
        "missing": {
          "action": "omit-output"
        },
        "null": {
          "action": "omit-output"
        },
        "empty": {
          "action": "omit-output"
        },
        "zero": {
          "action": "omit-output"
        },
        "invalid": {
          "action": "hold-record"
        },
        "unknown": {
          "action": "omit-output"
        }
      },
      "examples": [
        {
          "id": "me-1",
          "input": {
            "id": 29951
          },
          "expected": [
            {
              "outputId": "m-ext",
              "writeOperation": "importMedia",
              "values": [
                {
                  "origin": "wordpress",
                  "externalId": "29951"
                }
              ]
            }
          ]
        },
        {
          "id": "me-2",
          "input": {},
          "expected": [
            {
              "outputId": "m-ext",
              "writeOperation": "importMedia",
              "omitted": true
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "m-ext",
          "sourcePaths": [
            "id"
          ],
          "targetRef": "media/media-file",
          "writeOperation": "importMedia",
          "targetPath": "externalInfo",
          "verification": {
            "unverifiableReason": "Media Manager cannot filter or read back externalInfo (webhook-only); the file is found by sourceUrl and the crosswalk row."
          }
        }
      ]
