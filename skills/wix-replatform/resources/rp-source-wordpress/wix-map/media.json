{
  "schemaVersion": 1,
  "kind": "wix-map-suggestion",
  "sourcePlatform": "woocommerce",
  "primaryKey": "id",
  "sourceEntity": "media",
  "targetRef": "media/media-file",
  "targetEntity": "media-file",
  "preferredWrite": "importMedia",
  "requiredSourceEntityRefs": [],
  "provenance": [
    "store T 11-16 live run 09895795 reviewed plan (mapping rounds 7-8)"
  ],
  "holdCodes": {},
  "fieldMappings": [
    {
      "id": "media-url",
      "sourcePaths": [
        "source_url"
      ],
      "disposition": "native",
      "reason": "The full-size file URL is what Media Manager fetches. Every media library file is imported (import everything); posts and products resolve their images to these files by source URL.",
      "evidence": [
        "resources/rp-target-wix/domains/media/entities/media-file.json (preferredWrite importMedia; mappingGuidance: import referenced media by default)",
        "resources/rp-target-wix/lib/blog-post-media.js (post media import: cover and inline images)",
        "resources/rp-mapper/SKILL.md \"Default media scope\""
      ],
      "transform": {
        "kind": "expression",
        "expression": "Copy source_url unchanged when it is a nonempty http(s) URL; the importer percent-encodes it. Missing, null or empty: return to mapping (the file cannot be imported)."
      },
      "valuePolicy": {
        "missing": {
          "action": "omit-output"
        },
        "null": {
          "action": "omit-output"
        },
        "empty": {
          "action": "omit-output"
        },
        "zero": {
          "action": "omit-output"
        },
        "invalid": {
          "action": "hold-record"
        },
        "unknown": {
          "action": "omit-output"
        }
      },
      "examples": [
        {
          "id": "mu-1",
          "input": {
            "source_url": "https://example.com/wp-content/uploads/a.jpg"
          },
          "expected": [
            {
              "outputId": "m-url",
              "writeOperation": "importMedia",
              "values": [
                "https://example.com/wp-content/uploads/a.jpg"
              ]
            }
          ]
        },
        {
          "id": "mu-2",
          "input": {},
          "expected": [
            {
              "outputId": "m-url",
              "writeOperation": "importMedia",
              "omitted": true
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "m-url",
          "sourcePaths": [
            "source_url"
          ],
          "targetRef": "media/media-file",
          "writeOperation": "importMedia",
          "targetPath": "url",
          "verification": {
            "readPath": "sourceUrl"
          }
        }
      ]
    },
    {
      "id": "media-display-name",
      "sourcePaths": [
        "title.rendered",
        "filename"
      ],
      "disposition": "native",
      "reason": "Display name is the attachment title, else the file name. Every media library file is imported (import everything); posts and products resolve their images to these files by source URL.",
