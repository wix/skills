        "resources/rp-mapper/SKILL.md \"Default media scope\""
      ],
      "transform": {
        "kind": "expression",
        "expression": "Use title.rendered when it is a nonempty string after trimming; otherwise filename; otherwise omit (the importer derives a name from the URL)."
      },
      "valuePolicy": {
        "missing": {
          "action": "omit-output"
        },
        "null": {
          "action": "omit-output"
        },
        "empty": {
          "action": "omit-output"
