      "builder": "rp-source-wordpress/wix-map/contact.build.js#contactAddresses",
      "choice": {
        "name": "contact-same-address-once",
        "value": "once",
        "default": "once",
        "reason": "Two identical address items on a contact are noise for the merchant; nothing is lost because the values are equal. Tuti rev 3 wrote both.",
        "decidedBy": "suggestion",
        "question": "When the shipping address equals the billing address, write it once or twice?",
        "options": [
          "once",
          "twice"
        ],
        "forElad": false
      }
    }
  ],
  "leftovers": {
    "disposition": "cms",
    "transform": {
      "kind": "helper",
      "name": "source-archive.buildArchiveRecord",
      "revision": "source-archive-retention-v1",
      "arguments": {
        "sourceEntity": "customer",
        "sourceKeyPath": "id"
      }
    },
    "reason": "Every customer field no row above writes (dates, username, role, is_paying_customer, avatar_url, meta_data, billing.email, _links) is kept in the private source-archive collection, the same as the Tuti and Poratus runs. IP address and user agent are dropped by the archive helper."
  },
  "choices": [
    {
      "decisionId": null,
      "name": "contact-role-label",
      "value": "none",
      "default": "none",
      "reason": "Every customer on Tuti and Poratus has role \"customer\", so the label carries no information. The role stays in the source archive. A label would need crm/label + crm/contact-label writes (never tags inside the upsert body: OVERWRITE replaces existing tags).",
      "decidedBy": "suggestion",
      "question": "Put a contact label for the WordPress role (for example \"customer\")?",
      "options": [
        "none",
        "role-label"
      ],
      "forElad": false
    },
    {
      "decisionId": null,
      "name": "contact-accounts-as-members",
      "value": "contacts-only",
      "default": "contacts-only",
      "reason": "Members need consent and a password reset email to the customer; contacts carry the full history without any message. A members import is its own entity and decision.",
      "decidedBy": "suggestion",
      "question": "Make WooCommerce customer accounts site members?",
      "options": [
        "contacts-only",
        "members"
      ],
      "forElad": true
    },
    {
      "decisionId": null,
      "name": "order-referenced-users",
      "value": "import-as-contacts",
      "default": "import-as-contacts",
      "reason": "The WooCommerce customer list returns role customer only. A shop manager or administrator who placed orders is left out, and those orders cannot link to a buyer contact. The extractor reads each such user by id (GET /wc/v3/customers/{id}, read-only) after the orders and maps them with the same contact rows, so their orders import. No message is sent; they are contacts, not members.",
      "decidedBy": "suggestion",
      "question": "Import WordPress users who placed orders but are not WooCommerce customers (for example staff or admin accounts) as contacts, so their orders import?",
      "options": [
        "import-as-contacts",
        "not-imported"
      ],
      "forElad": false
    }
  ],
  "guestBuyer": {
    "about": "Orders placed without an account (customer_id 0; 5,164 of 7,861 Tuti orders) still need a buyer contact. The toolkit builds those contacts; no row or plan entity is written by the AI. Whether they are built follows the order's guest-buyers choice (order.json: import-as-contacts default, email-only, not-imported).",
    "sourceEntity": "guest-buyer-contact",
    "fromSourceEntity": "order",
    "when": "order.customer_id is 0",
    "key": "rp-target-wix/order-buyer.js#guestBuyerContactKey (one contact per normalized billing email, else per order)",
    "rows": "rp-target-wix/order-buyer.js#guestBuyerContactRows (name, email, phone, company from the order billing, else shipping, details)",
    "orderSide": "rp-target-wix/order-buyer.js#guestBuyerContactId resolves buyerInfo.contactId with the same key",
    "write": "the same importContacts composite as customers, before the order task"
  }
}
