{
  "schemaVersion": 1,
  "kind": "wix-map-suggestions",
  "sourceSystem": "woocommerce",
  "sourceEntity": "customer",
  "targetRef": "crm/contact",
  "preferredWrite": {
    "writerId": "bulkUpsertContacts",
    "composite": "rp-target-wix/lib/contact-import.js#importContacts"
  },
  "builders": "rp-source-wordpress/wix-map/contact.build.js",
  "about": "Ready-made map for a WooCommerce customer to a Wix contact. Rows use the mapping plan fieldMappings format, so a pre-fill copies them as-is. The AI uses them unless the operator asks otherwise; an operator change edits the copied plan row, never this file. Grows only through a reviewed PR.",
  "sources": [
    "Tuti 11-15 rev 3 (tuti-work/step6-2026-11-15)",
    "Poratus 11-15 (poratus-woo-20261115-1133)",
    "Tuti and Poratus 11-10 runs"
  ],
  "matchKey": {
    "sourceKey": "id",
    "dedupe": "importContacts matches an existing contact by main email; two customers sharing an email become one contact and both ids point to it in the crosswalk."
  },
  "fieldMappings": [
    {
      "id": "contact-name",
      "sourcePaths": [
        "first_name",
        "last_name",
        "billing.first_name",
        "billing.last_name",
        "shipping.first_name",
        "shipping.last_name"
      ],
      "disposition": "native",
      "reason": "Account name first, then billing name, then shipping name; HTML entities decoded, spaces trimmed. Same in the Tuti and Poratus runs.",
      "transform": {
        "kind": "helper",
        "name": "rp-source-wordpress/wix-map/contact.build.js#contactName",
        "revision": "wix-map-v1",
        "arguments": {
          "first": [
            "first_name",
            "billing.first_name",
            "shipping.first_name"
          ],
          "last": [
            "last_name",
            "billing.last_name",
            "shipping.last_name"
          ]
        },
        "precedence": [
          "first_name",
          "billing.first_name",
          "shipping.first_name"
        ]
      },
      "valuePolicy": {
        "missing": {
          "action": "omit-output"
        },
        "null": {
          "action": "omit-output"
        },
        "empty": {
          "action": "omit-output"
        },
        "zero": {
          "action": "write-as-is"
        },
        "invalid": {
          "action": "hold-record"
        },
        "unknown": {
          "action": "omit-output"
        }
      },
      "examples": [
        {
          "id": "account-name",
          "input": {
            "first_name": "Dana",
            "last_name": "Levi",
            "billing": {
              "first_name": "D"
            }
          },
          "expected": [
            {
              "outputId": "first",
              "value": "Dana",
              "writeOperation": "bulkUpsertContacts"
            },
            {
              "outputId": "last",
              "value": "Levi",
              "writeOperation": "bulkUpsertContacts"
            }
          ]
        },
        {
          "id": "billing-fallback",
          "input": {
            "first_name": "",
            "last_name": "",
            "billing": {
              "first_name": "Noa",
              "last_name": "Cohen &amp; Co"
            }
          },
          "expected": [
            {
              "outputId": "first",
              "value": "Noa",
              "writeOperation": "bulkUpsertContacts"
            },
            {
              "outputId": "last",
              "value": "Cohen & Co",
              "writeOperation": "bulkUpsertContacts"
            }
          ]
        },
        {
          "id": "no-name",
          "input": {
            "first_name": "",
            "last_name": "",
            "billing": {},
            "shipping": {}
          },
          "expected": [
            {
              "outputId": "first",
              "omitted": true,
              "writeOperation": "bulkUpsertContacts"
            },
            {
              "outputId": "last",
              "omitted": true,
              "writeOperation": "bulkUpsertContacts"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "first",
          "sourcePaths": [
            "first_name",
            "billing.first_name",
            "shipping.first_name"
          ],
          "targetRef": "crm/contact",
          "writeOperation": "bulkUpsertContacts",
          "targetPath": "name.first",
          "verification": {
            "readPath": "contact.name.first"
          }
        },
        {
          "id": "last",
          "sourcePaths": [
            "last_name",
            "billing.last_name",
            "shipping.last_name"
          ],
          "targetRef": "crm/contact",
          "writeOperation": "bulkUpsertContacts",
          "targetPath": "name.last",
          "verification": {
            "readPath": "contact.name.last"
          }
        }
      ],
      "evidence": [
        {
          "kind": "run",
          "ref": "Tuti 11-15 rev 3 mapping-plan.json customer rows"
        },
        {
          "kind": "run",
          "ref": "Poratus 11-15 mapping-plan.json customer rows"
        },
        {
          "kind": "target",
          "ref": "rp-target-wix/domains/crm/entities/contact.json intendedFields"
        }
      ],
      "builder": "rp-source-wordpress/wix-map/contact.build.js#contactName"
    },
