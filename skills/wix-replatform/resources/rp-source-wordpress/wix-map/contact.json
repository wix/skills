            "shipping.state"
          ],
          "targetRef": "crm/contact",
          "writeOperation": "bulkUpsertContacts",
          "targetPath": "addresses[].address.subdivision",
          "verification": {
            "readPath": "contact.addresses[].address.subdivision"
          },
          "appliesWhen": {
            "op": "fact",
