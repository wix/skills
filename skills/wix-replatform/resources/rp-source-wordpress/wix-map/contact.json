    {
      "id": "contact-addresses",
      "sourcePaths": [
        "billing.address_1",
        "billing.address_2",
        "billing.city",
        "billing.postcode",
        "billing.country",
        "billing.state",
        "shipping.address_1",
        "shipping.address_2",
        "shipping.city",
        "shipping.postcode",
        "shipping.country",
        "shipping.state"
      ],
      "disposition": "native",
      "reason": "Billing address then shipping address, each a Contacts V5 address item (address_1 -> addressLine, never addressLine1; #662). A state code becomes an ISO 3166-2 subdivision (US + CO -> US-CO). A country alone is not an address.",
      "transform": {
        "kind": "helper",
        "name": "rp-source-wordpress/wix-map/contact.build.js#contactAddresses",
        "revision": "wix-map-v1",
        "arguments": {
          "items": [
            "billing",
            "shipping"
          ],
          "tags": {
            "billing": "BILLING",
            "shipping": "SHIPPING"
          },
          "fields": {
            "address_1": "addressLine",
            "address_2": "addressLine2",
            "city": "city",
            "postcode": "postalCode",
            "country": "country",
            "state": "subdivision"
          },
          "choice": "contact-same-address-once"
        }
      },
      "valuePolicy": {
        "missing": {
          "action": "omit-output"
        },
        "null": {
          "action": "omit-output"
        },
        "empty": {
          "action": "omit-output"
        },
        "zero": {
          "action": "write-as-is"
        },
        "invalid": {
          "action": "hold-record"
        },
        "unknown": {
          "action": "omit-output"
        }
      },
      "examples": [
        {
          "id": "billing-only",
          "input": {
            "billing": {
              "address_1": "12 Example St",
              "city": "Testville 3",
              "postcode": "1234567",
              "country": "IL",
              "state": ""
            },
            "shipping": {
              "country": "IL"
            }
          },
          "expected": [
            {
              "outputId": "addressLine",
              "values": [
                "12 Example St"
              ],
              "writeOperation": "bulkUpsertContacts"
            },
            {
              "outputId": "city",
              "values": [
                "Testville 3"
              ],
              "writeOperation": "bulkUpsertContacts"
            },
            {
              "outputId": "postalCode",
              "values": [
                "1234567"
              ],
              "writeOperation": "bulkUpsertContacts"
            },
            {
              "outputId": "country",
              "values": [
                "IL"
              ],
              "writeOperation": "bulkUpsertContacts"
            },
            {
              "outputId": "tag",
              "values": [
                "BILLING"
              ],
              "writeOperation": "bulkUpsertContacts"
            }
          ]
        },
        {
          "id": "us-state",
          "input": {
            "billing": {
              "address_1": "5 Example St",
              "city": "Testville 1",
              "country": "US",
              "state": "CO"
            },
            "shipping": {
              "address_1": "9 Example St",
              "city": "Testville 2",
              "country": "US",
              "state": "WA"
            }
          },
          "expected": [
            {
              "outputId": "addressLine",
              "values": [
                "5 Example St",
                "9 Example St"
              ],
              "writeOperation": "bulkUpsertContacts"
            },
            {
              "outputId": "subdivision",
              "values": [
                "US-CO",
                "US-WA"
              ],
              "writeOperation": "bulkUpsertContacts"
            },
            {
              "outputId": "tag",
              "values": [
                "BILLING",
                "SHIPPING"
              ],
              "writeOperation": "bulkUpsertContacts"
            }
          ]
        }
      ],
      "outputs": [
