      "outputs": [
        {
          "id": "email",
          "sourcePaths": [
            "email"
          ],
          "targetRef": "crm/contact",
          "writeOperation": "bulkUpsertContacts",
          "targetPath": "email.email",
          "verification": {
            "readPath": "contact.email.email"
          }
        }
      ],
      "evidence": [
        {
          "kind": "run",
          "ref": "Tuti 11-15 rev 3 mapping-plan.json customer rows"
        },
        {
          "kind": "run",
          "ref": "Poratus 11-15 mapping-plan.json customer rows"
        },
        {
          "kind": "target",
          "ref": "rp-target-wix/domains/crm/entities/contact.json intendedFields"
