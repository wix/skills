        {
          "id": "ct-2",
          "input": {
            "discount_type": "fixed_cart",
            "amount": "20.00"
          },
          "expected": [
            {
              "outputId": "moneyOffAmount",
              "writeOperation": "createCoupon",
              "value": 20
            }
          ]
        },
        {
          "id": "ct-3",
          "input": {
            "discount_type": "fgf_free_gift",
            "amount": "0"
          },
          "expected": [
            {
              "outputId": "percentOffRate",
              "writeOperation": "createCoupon",
