            "readPath": "specification.percentOffRate"
          },
          "writeInput": "specification"
        },
        {
          "id": "moneyOffAmount",
          "sourcePaths": [
            "discount_type",
            "amount",
            "free_shipping"
          ],
          "targetRef": "stores/coupon",
          "writeOperation": "createCoupon",
          "targetPath": "moneyOffAmount",
          "verification": {
            "readPath": "specification.moneyOffAmount"
          },
          "writeInput": "specification"
        },
        {
          "id": "freeShipping",
          "sourcePaths": [
            "discount_type",
            "amount",
            "free_shipping"
          ],
          "targetRef": "stores/coupon",
          "writeOperation": "createCoupon",
          "targetPath": "freeShipping",
          "verification": {
            "readPath": "specification.freeShipping"
          },
          "writeInput": "specification",
          "appliesWhen": {
            "op": "equals",
            "location": "free_shipping",
            "value": true
          }
        }
      ],
      "choice": {
        "name": "coupon-type-amount",
        "value": {
          "coupon-free-shipping-with-amount": "free shipping wins; the amount is dropped with a finding",
          "coupon-unsupported-type": "hold-record",
          "coupon-fixed-product-storewide": "hold-record",
          "coupon-amount-over-2-decimals": "hold-record"
        },
        "default": {
          "coupon-free-shipping-with-amount": "free shipping wins; the amount is dropped with a finding",
          "coupon-unsupported-type": "hold-record",
          "coupon-fixed-product-storewide": "hold-record",
          "coupon-amount-over-2-decimals": "hold-record"
        },
        "reason": "This row decides several values; each part has its own default and reason.",
        "decidedBy": "suggestion",
        "parts": [
          {
            "name": "coupon-free-shipping-with-amount",
            "value": "free shipping wins; the amount is dropped with a finding",
            "default": "free shipping wins; the amount is dropped with a finding",
            "reason": "A Wix coupon cannot carry both (coupon.json pitfall). 27 coupons in stores T and P grant free shipping.",
            "decidedBy": "suggestion"
          },
          {
            "name": "coupon-unsupported-type",
            "value": "hold-record",
            "default": "hold-record",
            "reason": "Free-gift and BOGO coupons (store T 3, store P 3) would start discounting money if coerced.",
            "decidedBy": "suggestion"
          },
          {
            "name": "coupon-fixed-product-storewide",
            "value": "hold-record",
            "default": "hold-record",
            "reason": "A per-unit amount on every product has no Wix shape; moneyOffAmount takes it off once.",
            "decidedBy": "suggestion"
          },
          {
            "name": "coupon-amount-over-2-decimals",
            "value": "hold-record",
            "default": "hold-record",
            "reason": "Rounding would put a different amount on Wix than the merchant published.",
            "decidedBy": "suggestion"
          }
        ]
      }
    },
