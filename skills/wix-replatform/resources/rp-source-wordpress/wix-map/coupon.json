{
  "schemaVersion": 1,
  "kind": "wix-map-suggestion",
  "sourcePlatform": "woocommerce",
  "primaryKey": "id",
  "sourceEntity": "coupon",
  "targetRef": "stores/coupon",
  "targetEntity": "coupon",
  "preferredWrite": "createCoupon",
  "requiredSourceEntityRefs": [
    "product",
    "product-category"
  ],
  "builder": "rp-source-wordpress/wix-map/coupon.builder.js",
  "exampleConventions": "Example input merges onto a base percent coupon; references resolve as \"<ref:key>\".",
  "provenance": [
    "store T 11-15 run plan (coupon rows, all through coupon-discovery mapCouponToWix)",
    "store P 11-10 plan (coupon)"
  ],
  "holdCodes": {
    "coupon-code-missing": {
      "role": "site-owner",
      "severity": "low",
      "action": "These coupons have no code in the source and were not imported. Create them in Business Manager > Marketing > Coupons if still wanted.",
      "resolutionEvidence": "Each listed coupon exists on Wix or is confirmed unwanted."
    },
    "coupon-type-unmappable": {
      "role": "cutover-operator",
      "severity": "medium",
      "action": "These coupons have a type Wix coupons cannot hold (free gift, buy-one-get-one, a per-unit amount on every product, or no amount) and were not imported. Recreate the offer another way in Business Manager (for example an automatic discount), or confirm it is no longer wanted.",
      "resolutionEvidence": "Each listed coupon has a Wix replacement or is confirmed unwanted."
    },
    "coupon-scope-unmappable": {
      "role": "cutover-operator",
      "severity": "medium",
      "action": "These coupons are limited in a way Wix coupons cannot hold (several products or categories, excluded products, sale items, a maximum amount, email limits, or a minimum spend with a product limit). They were not imported, so none is more generous than published. Recreate each as one or more Wix coupons or discounts, or confirm it is no longer wanted.",
      "resolutionEvidence": "Each listed coupon has a Wix replacement or is confirmed unwanted."
    },
    "coupon-amount-precision-unsupported": {
      "role": "site-owner",
      "severity": "medium",
      "action": "These coupons have an amount with more than 2 decimals, which Wix cannot store. Create them by hand with the amount you want.",
      "resolutionEvidence": "Each listed coupon exists on Wix with a chosen amount."
    },
    "coupon-usage-limit-unresolved": {
      "role": "import-operator",
      "severity": "high",
      "action": "Requires Import Operator: these coupons have usage counts that are not whole numbers, so it cannot be decided whether they can still be used. Nothing was written.",
      "importOperatorPrompt": "Re-extract the listed coupons from WooCommerce (GET /wc/v3/coupons/<id>), check usage_limit / usage_count, and rerun the coupon import for these ids.",
      "resolutionEvidence": "Each listed coupon is imported or confirmed unwanted."
    }
  },
  "fieldMappings": [
    {
      "id": "coupon-code",
      "sourcePaths": [
        "code"
      ],
      "disposition": "native",
      "reason": "The coupon code is also its name. A coupon the reviewed mapping refuses is held from every row with the same code.",
      "evidence": [
        "rp-source-wordpress/lib/coupon-discovery.js mapCouponToWix",
        "resources/rp-target-wix/domains/stores/entities/coupon.json"
      ],
      "transform": {
        "kind": "helper",
        "name": "rp-source-wordpress/wix-map/coupon.builder.js#couponCode",
        "revision": "rp-source-wordpress/wix-map/coupon.builder.js",
        "arguments": {}
      },
      "valuePolicy": {
        "missing": {
          "action": "hold-record",
          "code": "coupon-code-missing"
        },
        "null": {
          "action": "hold-record",
          "code": "coupon-code-missing"
        },
        "empty": {
          "action": "hold-record",
          "code": "coupon-code-missing"
        },
        "zero": {
          "action": "write-as-is"
        },
        "invalid": {
          "action": "hold-record"
        },
        "unknown": {
          "action": "omit-output"
        }
      },
      "examples": [
        {
          "id": "cc-1",
          "input": {
            "code": "SAMPLE10"
          },
          "expected": [
            {
              "outputId": "code",
              "writeOperation": "createCoupon",
              "value": "SAMPLE10"
            },
            {
              "outputId": "name",
              "writeOperation": "createCoupon",
              "value": "SAMPLE10"
            }
          ]
        }
      ],
      "outputs": [
        {
          "id": "code",
          "sourcePaths": [
            "code"
          ],
          "targetRef": "stores/coupon",
          "writeOperation": "createCoupon",
          "targetPath": "code",
          "verification": {
            "readPath": "specification.code"
          },
          "writeInput": "specification"
        },
        {
          "id": "name",
          "sourcePaths": [
            "code"
          ],
          "targetRef": "stores/coupon",
          "writeOperation": "createCoupon",
          "targetPath": "name",
          "verification": {
            "readPath": "specification.name"
          },
          "writeInput": "specification"
        }
      ],
      "choice": {
        "name": "coupon-code",
        "value": {
          "coupon-name": "the code",
          "coupon-plugin-rule": "written switched off, tagged Rule_Not_Carried"
        },
        "default": {
          "coupon-name": "the code",
          "coupon-plugin-rule": "written switched off, tagged Rule_Not_Carried"
        },
        "reason": "This row decides several values; each part has its own default and reason.",
        "decidedBy": "suggestion",
        "parts": [
          {
            "name": "coupon-name",
            "value": "the code",
            "default": "the code",
            "reason": "WooCommerce coupons have no separate name; the description is archived.",
            "decidedBy": "suggestion"
          },
          {
            "name": "coupon-plugin-rule",
            "value": "written switched off, tagged Rule_Not_Carried",
            "default": "written switched off, tagged Rule_Not_Carried",
            "reason": "A coupon plugin rule Wix cannot hold (free gift, role, payment or location limit) must not go live without it (coupon-discovery plugin rules). The cutover task lists them by id.",
            "decidedBy": "suggestion",
            "alternatives": [
              "hold-record"
            ]
          }
        ]
      }
    },
    {
      "id": "coupon-type-amount",
      "sourcePaths": [
        "discount_type",
        "amount",
        "free_shipping"
      ],
      "disposition": "native",
      "reason": "percent -> percentOffRate; fixed_cart, and fixed_product on named products, -> moneyOffAmount; free shipping is its own Wix type and wins over an amount. Other types (free gift, BOGO) have no Wix coupon and are held.",
      "evidence": [
        "rp-source-wordpress/lib/coupon-discovery.js mapCouponToWix",
        "resources/rp-target-wix/domains/stores/entities/coupon.json"
      ],
      "transform": {
        "kind": "helper",
