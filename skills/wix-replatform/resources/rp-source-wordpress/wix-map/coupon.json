        "invalid": {
          "action": "hold-record"
        },
        "unknown": {
          "action": "omit-output"
        }
      },
      "examples": [
        {
          "id": "ct-1",
          "input": {
            "discount_type": "percent",
            "amount": "15"
          },
          "expected": [
            {
              "outputId": "percentOffRate",
              "writeOperation": "createCoupon",
              "value": 15
            },
            {
              "outputId": "moneyOffAmount",
              "writeOperation": "createCoupon",
