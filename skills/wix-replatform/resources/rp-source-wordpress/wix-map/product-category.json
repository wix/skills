      "choice": {
        "name": "product-category-name-missing",
        "value": "fallback name: decoded slug, else \"Category <source id>\"",
        "default": "fallback name: decoded slug, else \"Category <source id>\"",
        "reason": "Import everything: a nameless term is neither dropped nor held. The merchant renames it, or keeps the fallback (cutover task).",
        "decidedBy": "suggestion",
        "alternatives": [
          "omit-output",
          "hold-record"
        ]
      }
    },
