        "null": {
          "action": "write-as-is"
        },
        "empty": {
          "action": "write-as-is"
        },
        "zero": {
          "action": "write-as-is"
        },
        "invalid": {
          "action": "hold-record"
        },
        "unknown": {
          "action": "omit-output"
        }
      },
      "examples": [
        {
          "id": "pcn-1",
          "input": {
            "name": "Beans &amp; Capsules"
