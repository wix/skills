        {
          "id": "pcn-3",
          "input": {
            "id": 78,
            "name": "  ",
            "slug": ""
          },
          "expected": [
            {
              "outputId": "name",
              "writeOperation": "createStoresCategory",
              "value": "Category 78"
            }
          ]
        }
      ],
      "outputs": [
