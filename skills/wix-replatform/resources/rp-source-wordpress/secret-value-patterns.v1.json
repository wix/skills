{
  "schemaVersion": 1,
  "allowPrefixes": ["pm_", "cus_", "src_", "card_", "sub_", "in_", "ch_", "pi_",
                    "seti_", "tok_", "price_", "prod_", "evt_", "pk_live_", "pk_test_"],
  "denyPrefixes": ["sk_live_", "sk_test_", "rk_live_", "rk_test_", "whsec_",
                   "-----BEGIN", "AKIA", "ghp_", "github_pat_", "cs_"],
  "denyPatterns": [
    { "id": "jwt", "regex": "^eyJ[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]*$" },
    { "id": "long-opaque", "regex": "^[A-Fa-f0-9]{40,}$|^[A-Za-z0-9+/=]{40,}$" }
  ]
}
